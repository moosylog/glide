uid = "custom_code_to_behaviors"

title = "Convert my Custom Defined Behaviors"

subtitle = "Migrate your ZMK DTSI to Layout Editor native behaviors"

description = '''
Moves mod-morphs, tap-dances, hold-taps, sticky keys and macros (with up to two parameters) out of your Custom Defined Behaviors code and into the behaviors lists, where you can edit them visually. Keys that called them through the Custom key are switched to the new behaviors. Anything it can't convert safely stays in the code, and you get a list saying why.

⛔ **Not supported:** complex code that uses the C preprocessor (`#define`, `#include`, `#if`, `#ifdef`, `#ifndef`, `#else`, `#endif`, `#undef`). If it finds any, it stops and changes nothing. Very large code is refused too (more than 1,000 lines or 100 behaviors), because it would take too long to convert safely here. Your Custom Devicetree is never touched.'''

script = '''
# ==============================================================================
# Convert my Custom Defined Behaviors
#
# Input : a layout whose `custom_defined_behaviors` holds ZMK devicetree text (DTSI).
# Output: the same layout where every behavior this script fully understands is a native
#         JSON behavior (macros / holdTaps / tapDances / modMorphs / stickyKeys), its text
#         is removed from the code field, and `Custom` keys that called it by name are
#         rewritten to call the native behavior. Everything else is left byte for byte.
#         A per-run report for the result screen is returned in ._flowReport, which GLIDE
#         reads and strips (core/capabilities/applyFlow.js); it never reaches the layout.
#
# Stages (see `main`):
#   1. mask comments, find `label: name { ... };` blocks (no nested braces)
#   2. convert each block on its own (`convert` errors = "left as code" + reason)
#   3. drop blocks that clash with existing names, repeat, or sit inside foreign blocks
#   4. settle: convert a block only once everything it refers to exists (built-in, already
#      native, or converted in an earlier round), so definition order never matters
#   5. remove converted text, append native behaviors, then rewrite `Custom` keys (`finish`)
#
# Guard rails (`main` stops with an error and changes nothing, before any heavy work):
#   - more than LIMITS.lines lines or LIMITS.blocks behavior blocks: the run time grows much faster than the
#     size (about 14 s for 100 blocks, 54 s for 200 in jq-web), so a big file would freeze the page;
#   - any C preprocessor directive (#define, #include, #if ...): generated or conditional code can't be
#     converted faithfully, so the whole file is refused instead of being half converted.
# Deliberately NOT converted: properties the editor has no
# field for (e.g. global-quick-tap), blocks referring to undefined behaviors, loops.
# The commit gate re-checks the result, so a mistake here is refused, not applied.
# ==============================================================================

# Behaviors GLIDE/MoErgo provide without a definition (kept in step with core/integrity/references.js).
def BUILTIN: ["&kp","&mt","&lt","&mo","&to","&tog","&sl","&sk","&trans","&none","&bt","&out","&rgb_ug","&ext_power",
  "&magic","&lower","&layer","&caps_word","&key_repeat","&studio_unlock","&bootloader","&sys_reset","&reset","&gresc",
  "&mkp","&mmv","&msc","&soft_off","&macro_tap","&macro_press","&macro_release","&macro_pause_for_release",
  "&macro_wait_time","&macro_tap_time","&macro_param_1to1","&macro_param_1to2","&macro_param_2to1","&macro_param_2to2"];
def isFirmwareName: test("^&bt_\\d+$");   # &bt_0 .. &bt_N are generated by the firmware

def KINDS: {"zmk,behavior-mod-morph":"modMorph", "zmk,behavior-tap-dance":"tapDance", "zmk,behavior-sticky-key":"stickyKey",
  "zmk,behavior-hold-tap":"holdTap", "zmk,behavior-macro":"macro", "zmk,behavior-macro-one-param":"macro", "zmk,behavior-macro-two-param":"macro"};
def LISTS: {modMorph:"modMorphs", tapDance:"tapDances", stickyKey:"stickyKeys", holdTap:"holdTaps", macro:"macros"};
def WORDS: {modMorph:"mod-morph", tapDance:"tap-dance", stickyKey:"sticky key", holdTap:"hold-tap", macro:"macro"};
# Properties each kind can carry into the native JSON; any other property keeps the block as code.
def ALLOWED: {
  modMorph: ["mods","keep-mods"],
  tapDance: ["tapping-term-ms"],
  stickyKey: ["release-after-ms","quick-release","lazy","ignore-modifiers"],
  holdTap: ["flavor","tapping-term-ms","quick-tap-ms","require-prior-idle-ms","hold-trigger-key-positions",
            "hold-trigger-on-release","hold-while-undecided","hold-while-undecided-linger","retro-tap"],
  macro: ["wait-ms","tap-ms"]};
def MODS: ["MOD_LCTL","MOD_LSFT","MOD_LALT","MOD_LGUI","MOD_RCTL","MOD_RSFT","MOD_RALT","MOD_RGUI"];
def FLAVORS: ["hold-preferred","balanced","tap-preferred","tap-unless-interrupted"];

def plural($n; $w): "\($n) \($w)\(if $n == 1 then "" else "s" end)";

# ---- guard rails -----------------------------------------------------------------------------------------------
def LIMITS: {lines: 1000, blocks: 100};
# The C preprocessor directives. (`#binding-cells` and `#address-cells` are ordinary devicetree properties, not these.)
def DIRECTIVE: "^[ \\t]*#[ \\t]*(define|include|if|ifdef|ifndef|elif|else|endif|undef|pragma|error|warning)\\b";

# ---- reading the text ------------------------------------------------------------------------------------------
# Comments become spaces of the same length, so offsets still match the original text and a commented-out
# behavior is never mistaken for a real one.
def maskComments:
  gsub("(?<c>/\\*[\\s\\S]*?\\*/)"; (.c | gsub("[^\n]"; " "))) | gsub("(?<c>//[^\n]*)"; (.c | gsub("[^\n]"; " ")));
def props:
  [match("([#A-Za-z][\\w#,.-]*)\\s*(?:=\\s*(\"[^\"]*\"|[^;\"]*))?\\s*;"; "g") | .captures
   | {key: .[0].string, value: (.[1].string | if . == null then true else gsub("\\s+$"; "") end)}]
  | from_entries;
def groups: [match("<([^>]*)>"; "g") | .captures[0].string];
def toks: gsub("\\s*\\(\\s*"; "(") | gsub("\\s*\\)"; ")") | [splits("\\s+")] | map(select(length > 0));

# One parameter: 4 -> {value:4}, SQT -> {value:"SQT"}, LS(LA(N2)) -> {value:"LS",params:[{value:"LA",params:[{value:"N2"}]}]}
def prm:
  if startswith("&") then error("has a behavior nested inside another binding")
  elif test("^-?\\d+$") then {value: tonumber}
  elif test("^[A-Za-z_]\\w*\\(.*\\)$") then capture("^(?<f>[A-Za-z_]\\w*)\\((?<a>.*)\\)$") | {value: .f, params: [.a | prm]}
  else {value: .} end;
# A token list like ["&kp","LS(SQT)"] -> {value:"&kp", params:[...]}
def binding:
  if length == 0 or (.[0] | startswith("&") | not) then error("has a binding that does not start with &")
  else {value: .[0]} + (if length > 1 then {params: (.[1:] | map(prm))} else {} end) end;
def bname: if length == 1 and (.[0] | startswith("&")) then .[0] else error("has a binding the editor can't hold here") end;
# Macro bindings are one flat list: <&macro_tap &kp A> is two bindings, &macro_tap and &kp A.
def macroBindings:
  reduce (groups[] | toks[]) as $t ([];
    if ($t | startswith("&")) then . + [{value: $t}]
    elif length == 0 then error("has a macro value before any behavior")
    else .[-1].params += [$t | prm] end);

def str: if type == "string" and test("^\"[^\"]*\"$") then .[1:-1] else error("has a text setting it can't read") end;
def num($lo; $hi; $what):
  if type == "string" and test("^<\\s*-?\\d+\\s*>$") then (gsub("[<>\\s]"; "") | tonumber) as $v
    | if $v < $lo or $v > $hi then error("has \($what) outside \($lo) to \($hi)") else $v end
  else error("has a number setting it can't read (\($what))") end;
# A flag property is written without a value (`quick-release;`); anything else is not a plain flag.
def flag($p; $k): if ($p | has($k)) then (if $p[$k] == true then true else error("has a yes/no setting it can't read (\($k))") end) else false end;
def mods:
  if . == null then error("has no modifiers set")
  elif (gsub("MOD_[A-Z]+|[<>()|\\s]"; "") | length) > 0 then error("has a modifier setting that is too complex")
  else [scan("MOD_[A-Z]+")] | if all(.[]; IN(MODS[])) then . else error("uses an unknown modifier") end end;

# ---- one block -> native behavior ------------------------------------------------------------------------------
def convert:
  . as $n | (.body | props) as $p
  | if (.body | test("\\\\\n")) then error("uses a line continuation (a backslash at the end of a line)") else . end
  | ($p.compatible // error("has no compatible setting") | str) as $c
  | (KINDS[$c] // error("is a kind the editor can't hold (\($c))")) as $kind
  | ($p | keys - ["compatible","label","#binding-cells","bindings"] - ALLOWED[$kind]) as $extra
  | if ($extra | length) > 0 then error("uses the setting \"\($extra[0])\", which the editor has no field for") else . end
  | if ("&" + $n.label | test("^&[a-zA-Z]\\w*$") and length <= 65) | not then error("has a name the editor doesn't allow (letters, numbers and _, starting with a letter)") else . end
  | ($p.bindings // error("has no bindings") | groups) as $gs
  | if ($gs | length) == 0 then error("has no bindings") else . end
  | (if $p.label then ($p.label | str) else $n.nodeName end) as $desc
  | if ($desc | length) > 1000 then error("has a label longer than 1000 characters") else . end
  | {name: ("&" + $n.label), description: $desc} as $base
  | {kind: $kind, label: $n.label,
     refs: ([$gs[] | toks[] | select(startswith("&"))] | unique),
     obj: (
       if $kind == "modMorph" then
         if ($gs | length) != 2 then error("needs exactly two bindings") else
         ($gs | map(toks | binding)) as $b
         | $base + {cases: [{binding: $b[0], mods: [], keepMods: []},
                            {binding: $b[1], mods: ($p.mods | mods), keepMods: (if $p["keep-mods"] then $p["keep-mods"] | mods else [] end)}]} end
       elif $kind == "tapDance" then
         $base + {tappingTermMs: (if $p["tapping-term-ms"] then $p["tapping-term-ms"] | num(1; 5000; "tapping-term-ms") else 200 end),
                  bindings: ($gs | map(toks | binding))}
       elif $kind == "stickyKey" then
         $base + {releaseAfterMs: (if $p["release-after-ms"] then $p["release-after-ms"] | num(1; 60000; "release-after-ms") else 1000 end),
                  quickRelease: flag($p; "quick-release"), lazy: flag($p; "lazy"), ignoreModifiers: flag($p; "ignore-modifiers"),
                  bindings: ($gs | map(toks | bname))}
       elif $kind == "holdTap" then
         if ($gs | length) != 2 then error("needs exactly two bindings") else
         $base + {tappingTermMs: ($p["tapping-term-ms"] // error("has no tapping-term-ms") | num(1; 5000; "tapping-term-ms")), bindings: ($gs | map(toks | bname))}
         + (if $p.flavor then {flavor: ($p.flavor | str | if IN(FLAVORS[]) then . else error("has an unknown flavor") end)} else {} end)
         + (if $p["quick-tap-ms"] then {quickTapMs: ($p["quick-tap-ms"] | num(-1; 5000; "quick-tap-ms"))} else {} end)
         + (if $p["require-prior-idle-ms"] then {requirePriorIdleMs: ($p["require-prior-idle-ms"] | num(-1; 5000; "require-prior-idle-ms"))} else {} end)
         + (if $p["hold-trigger-key-positions"] then {holdTriggerKeyPositions: ($p["hold-trigger-key-positions"] | if test("^<[\\d\\s]*>$") then [scan("\\d+") | tonumber] else error("has key positions it can't read") end)} else {} end)
         + (if flag($p; "hold-trigger-on-release") then {holdTriggerOnRelease: true} else {} end)
         + (if flag($p; "hold-while-undecided") then {holdWhileUndecided: true} else {} end)
         + (if flag($p; "hold-while-undecided-linger") then {holdWhileUndecidedLinger: true} else {} end)
         + (if flag($p; "retro-tap") then {retroTap: true} else {} end) end
       else
         $base + {bindings: ($p.bindings | macroBindings)}
         + (if $p["tap-ms"] then {tapMs: ($p["tap-ms"] | num(0; 100000; "tap-ms"))} else {} end)
         + (if $p["wait-ms"] then {waitMs: ($p["wait-ms"] | num(0; 100000; "wait-ms"))} else {} end)
       end)};

# Where a block sits: only directly inside `behaviors { }` (optionally within the root `/ { }`).
def placementProblem($masked):
  . as $n | ($masked[0:$n.start]) as $before
  | ($before | until(. == (gsub("\\{[^{}]*\\}"; "")); gsub("\\{[^{}]*\\}"; ""))) as $open
  | ([$open | match("([^\\s{};]+)\\s*\\{"; "g") | .captures[0].string] | map(select(. != "behaviors" and . != "/"))) as $foreign
  | if ($foreign | length) > 0 then "sits inside another block (\($foreign[0]))" else null end;

# Refs that are not (yet) defined anywhere we can see.
def unmet($known): (.refs - $known) | map(select(isFirmwareName | not));

# Convert in rounds: a block is ready when everything it refers to is known; each round adds its names.
def settle($known; $pending; $done; $round):
  ($pending | map(select(unmet($known) | length == 0))) as $ready
  | if ($ready | length) == 0 then {pending: $pending, done: $done}
    else settle($known + ($ready | map("&" + .label)); $pending | map(select(unmet($known) | length > 0)); $done + ($ready | map(. + {round: $round})); $round + 1) end;

# Removing blocks can leave empty `behaviors { };` (and `/ { };`) shells behind; tidy those and blank-line runs.
def tidy:
  reduce range(3) as $i (.; gsub("(^|\\s)behaviors\\s*\\{\\s*\\}\\s*;"; "") | gsub("(^|\\s)/\\s*\\{\\s*\\}\\s*;"; ""))
  | gsub("\n{3,}"; "\n\n") | sub("^\\s+"; "") | sub("\\s+$"; "");

def report($changed; $msg; $lines; $log): . + {_flowReport: {changed: $changed, message: $msg, lines: $lines, log: $log}};

# ---- verbose log helpers ---------------------------------------------------------------------------------------
def counts: [("macros","holdTaps","tapDances","modMorphs","stickyKeys") as $k | "\($k) \((.[$k] // []) | length)"] | join(", ");
def refSource($doneRounds; $existing; $external):
  if isFirmwareName or IN(BUILTIN[]) then "built-in"
  elif IN($existing[]) then "already native in the layout"
  elif IN($external[]) then "defined elsewhere in your code"
  elif $doneRounds[.] != null then "converted in round \($doneRounds[.])"
  else "not defined anywhere" end;
def layerName($cfg; $i): ($cfg.layer_names // [])[$i] // "layer \($i + 1)";

# ---- Custom keys -----------------------------------------------------------------------------------------------
# The "Custom" key type calls a behavior by name: params[0] is "&ctrl_gui" or "&ssk LCTRL" (name plus arguments).
# Once the behavior exists natively, such keys and combos call it directly; decoration stays on the key.
def isCustom($names):
  type == "object" and .value == "Custom" and (.params | type) == "array" and (.params | length) >= 1
  and (.params[0].value | type) == "string" and (.params[0].value | test("^\\s*&\\S"))
  and ((.params[0].value | [splits("\\s+")] | map(select(length > 0))[0]) | IN($names[]));
def fixCustom:
  . as $o
  | try ((.params[0].value | toks) as $t
      | .params[1:] as $rest
      | .value = $t[0] | .params = (($t[1:] | map(prm)) + $rest) | if (.params | length) == 0 then del(.params) else . end)
    catch $o;
def finish:
  . as $cfg
  | ([(.macros, .holdTaps, .tapDances, .modMorphs, .stickyKeys)[]?.name]) as $names
  | ([(.layers // []) | to_entries[] | .key as $li | .value | to_entries[] | select(.value | isCustom($names)) | (.value | fixCustom) as $fx | select($fx.value != "Custom")
       | "\(layerName($cfg; $li)), key \(.key + 1): Custom \(.value.params[0].value | tojson) -> \($fx.value)\(if $fx.params then " with \($fx.params | length) parameter(s)" else "" end)"]) as $keyLines
  | ([(.combos[]? | select(.binding | isCustom($names))) | .name as $nm | (.binding | fixCustom) as $fx | select($fx.value != "Custom")
       | "combo \($nm // "(unnamed)"): Custom -> \($fx.value)"]) as $comboLines
  | ($keyLines + $comboLines) as $changes
  | ($changes | length) as $cnt
  | if $cnt == 0 then . else
      ._flowReport as $r
      | .layers |= map(map(if isCustom($names) then fixCustom else . end))
      | (if .combos then .combos = (.combos | map(if (.binding | isCustom($names)) then (.binding = (.binding | fixCustom)) else . end)) else . end)
      | ._flowReport = {changed: true,
          message: ((if $r.changed then $r.message + " " else "" end) + "Updated \(plural($cnt; "key")) that called these behaviors through the Custom key so they use the native behavior directly."),
          lines: ($r.lines + [{ok: true, text: "\(plural($cnt; "key")) updated to call the native behavior"}]),
          log: (($r.log // []) + ["rewrote \($cnt) Custom key(s)/combo(s) to call native behaviors"] + ($changes[0:60] | map("  " + .)) + (if $cnt > 60 then ["  ... and \($cnt - 60) more"] else [] end))}
    end;

# ---- main ------------------------------------------------------------------------------------------------------
def main:
  . as $cfg
| ($cfg.custom_defined_behaviors) as $text
| if ($text | type) != "string" or ($text | test("\\S") | not) then
    $cfg | report(false; "Your layout has no custom code, so there is nothing to convert."; []; ["Custom Defined Behaviors is empty"])
  elif ($text | split("\n") | length) > LIMITS.lines then
    error("Your Custom Defined Behaviors are too large for this automation (\($text | split("\n") | length) lines, the limit is \(LIMITS.lines)). Nothing was changed. Remove behaviors you no longer use, or convert the rest by hand in the editor.")
  else
    ($text | maskComments) as $masked
    | ($masked | split("\n") | to_entries | map(select(.value | test(DIRECTIVE)))) as $directives
    | if ($directives | length) > 0 then
        error("Your Custom Defined Behaviors use the C preprocessor (\($directives | map("#" + (.value | scan(DIRECTIVE)[0])) | unique | join(", "))), which this automation doesn't support. Nothing was changed. The first one is on line \($directives[0].key + 1).")
      else . end
    | [$masked | match("([A-Za-z_]\\w*)\\s*:\\s*([A-Za-z_][\\w-]*)\\s*\\{([^{}]*)\\}\\s*;"; "g")
        | {start: .offset, end: (.offset + .length), label: .captures[0].string, nodeName: .captures[1].string, body: .captures[2].string}] as $nodes
    | if ($nodes | length) > LIMITS.blocks then error("Your Custom Defined Behaviors hold \($nodes | length) behaviors, which is more than this automation can convert safely (the limit is \(LIMITS.blocks)). Nothing was changed. Remove behaviors you no longer use, or convert the rest by hand in the editor.") else . end
    | ($nodes | map(.label)) as $labels
    | ([($cfg.macros, $cfg.holdTaps, $cfg.tapDances, $cfg.modMorphs, $cfg.stickyKeys)[]?.name]) as $existing
    # names the code defines outside the blocks we parse (custom_devicetree, other text): they count as known
    | ([($cfg.custom_defined_behaviors, $cfg.custom_devicetree) | strings | maskComments
        | scan("([A-Za-z_]\\w*)\\s*:\\s*[A-Za-z_][\\w-]*\\s*\\{") | "&" + .[0]] - ($labels | map("&" + .))) as $external
    | ($nodes | map(. as $n | try ($n + convert) catch ($n + {reason: .}))) as $tried
    | ($tried | map(. as $n
        | if .reason then .
          elif (($labels | map(select(. == $n.label)) | length) > 1) then . + {reason: "is defined more than once"}
          elif (("&" + .label) | IN(($existing + BUILTIN)[])) then . + {reason: "has the same name as a behavior that already exists in your layout"}
          else (placementProblem($masked)) as $why | if $why then . + {reason: $why} else . end end)) as $checked
    | ($checked | map(select(.reason == null))) as $ok
    | ($checked | map(select(.reason != null))) as $bad
    | settle(BUILTIN + $existing + $external; $ok; []; 1) as $s
    | ($s.pending | map("&" + .label)) as $stuck
    | ($s.pending | map(. + {reason: (
        unmet(BUILTIN + $existing + $external + ($s.done | map("&" + .label)))
        | map(if IN($stuck[]) then "waits for \(.), which can't be converted" else "uses \(.), which isn't defined in your layout" end)
        | join("; "))})) as $stuckBad
    | ($s.done | sort_by(.start)) as $done
    | (($bad + $stuckBad) | sort_by(.start)) as $kept
    | ($done | map({key: ("&" + .label), value: .round}) | from_entries) as $rounds
    | (["Code length: \($text | length) characters", "Behavior blocks found: \($nodes | length)", "Native behaviors before: \($cfg | counts)",
        "Names defined elsewhere in your code: \($external | length)"]
        + ($checked | map(. as $n
            | ($n.body | props | keys | map(select(. != "#binding-cells")) | join(", ")) as $pk
            | ($done | map(select(.label == $n.label)) | first) as $d
            | "block \($n.label) (\($n.start) to \($n.end)): properties [\($pk)]"
              + (if $d then " -> \(WORDS[$d.kind]), round \($d.round), refers to [\($d.refs | map(. + " (" + refSource($rounds; $existing; $external) + ")") | join("; "))]"
                 else " -> left as code: \(($kept | map(select(.label == $n.label)) | first | .reason) // "unknown")" end)))
        + ["Rounds needed: \(($done | map(.round) | max) // 0)"]) as $log
    | ($done | map({ok: true, text: "&\(.label) (\(WORDS[.kind]))"})) as $okLines
    | ($kept | map({ok: false, text: "&\(.label) stays as code: it \(.reason)"})) as $keptLines
    | if ($done | length) == 0 then
        $cfg | report(false;
          (if ($nodes | length) == 0 then "No behaviors written in a form this can convert were found in your code. Nothing was changed."
           else "None of the \(plural($nodes | length; "behavior")) found could be converted safely. Nothing was changed." end);
          $keptLines; $log)
      else
        (reduce ($done | reverse)[] as $d ($text; .[0:$d.start] + .[$d.end:]) | tidy) as $newText
        | reduce $done[] as $d ($cfg; .[LISTS[$d.kind]] = ((.[LISTS[$d.kind]] // []) + [$d.obj]))
        | .custom_defined_behaviors = $newText
        | . as $after
        | report(true;
            "Converted \(plural($done | length; "behavior")). They now show up in your behavior lists and every key that used them keeps working."
            + (if ($kept | length) > 0 then " \(plural($kept | length; "behavior")) could not be converted safely and stayed in Custom Defined Behaviors, exactly as it was." else "" end);
            $okLines + $keptLines; $log + ["Native behaviors after: \($after | counts)", "Code left in the field: \($newText | length) characters"])
      end
  end;

main | finish
'''

category = "Other"

successMessage = "Converted behaviors now appear in your behavior lists."

[manifest]
author = "moosyresearch"
keyboards = ["go60", "glove80"]
icon = "🔄"
keywords = ["devicetree", "dtsi", "custom code", "tap dance", "mod morph", "hold tap", "sticky", "convert", "import", "zmk"]
advanced = true
