uid = "mouse_emulation"

title = "Mouse from the keyboard"

subtitle = "Move, scroll and click with keys"

description = '''
Move, scroll and click the mouse from your keyboard: adds layers for pointer movement, scrolling and clicking. [How mouse emulation works](https://zmk.dev/docs/keymaps/behaviors/mouse-emulation).

✅ Turn on **HID_POINTING** in Advanced Configuration first, and re-pair Bluetooth if this is your first time using it.

Your base layer's thumb key becomes a layer-tap into the Mouse layer when it is a plain key press. If it is something else it is left alone, so assign a layer-tap or toggle key yourself.

⚠️ If your layout already has a layer named Mouse, MouseSlow, MouseFast or MouseWarp, nothing is changed.'''

script = '''
# ==============================================================================
# Mouse from the keyboard
#
# Adds four layers: Mouse (move, scroll, click), and MouseSlow, MouseFast and
# MouseWarp, which the Mouse layer holds to change the pointer speed. Then:
#   - the base layer's thumb key becomes a layer-tap into Mouse when it is a plain key press;
#   - the speed of each layer is set up in the input listeners (&mmv, &msc, and on Go60 the two trackpads).
# Listeners you already have are kept: only their slow/fast/warp speeds are added or replaced.
# If any of the four layers already exists, nothing is changed, so your own edits are never overwritten.
# ==============================================================================

# Limits and names. MAX_LAYERS is the layout schema's layer limit (schemas/*.json).
def MAX_LAYERS: 32;
def LAYERS: ["Mouse", "MouseSlow", "MouseFast", "MouseWarp"];

# The keys of the Mouse layer, per keyboard: [position, behavior, parameter]. A parameter of
# "slow", "fast" or "warp" means "the layer of that speed" and is replaced by its layer number below.
# thumbAt is the base layer position of the thumb key that becomes the layer-tap.
def glove80Table: {
  thumbAt: 73,
  keys: [
    [24, "&msc", "SCRL_LEFT"],  [25, "&mmv", "MOVE_UP"],    [26, "&msc", "SCRL_RIGHT"],
    [29, "&msc", "SCRL_LEFT"],  [30, "&msc", "SCRL_UP"],    [31, "&msc", "SCRL_DOWN"],  [32, "&msc", "SCRL_RIGHT"],
    [35, "&msc", "SCRL_UP"],    [36, "&mmv", "MOVE_LEFT"],  [37, "&mmv", "MOVE_DOWN"],  [38, "&mmv", "MOVE_RIGHT"],
    [41, "&mo", "warp"],        [42, "&mo", "fast"],        [43, "&mo", "slow"],
    [47, "&msc", "SCRL_DOWN"],  [48, "&mo", "slow"],        [49, "&mo", "fast"],        [50, "&mo", "warp"],
    [52, "&mkp", "MCLK"],       [54, "&mkp", "MB5"],
    [59, "&mmv", "MOVE_LEFT"],  [60, "&mmv", "MOVE_UP"],    [61, "&mmv", "MOVE_DOWN"],  [62, "&mmv", "MOVE_RIGHT"],
    [69, "&mkp", "LCLK"],       [70, "&mkp", "RCLK"],       [71, "&mkp", "MB4"],
    [75, "&mkp", "LCLK"],       [76, "&mkp", "RCLK"],       [77, "&mkp", "MCLK"],       [78, "&mkp", "MB4"], [79, "&mkp", "MB5"]
  ]
};
def go60Table: {
  thumbAt: 58,
  keys: [
    [13, "&msc", "SCRL_UP"],    [14, "&msc", "SCRL_LEFT"],  [15, "&mmv", "MOVE_UP"],    [16, "&msc", "SCRL_RIGHT"], [17, "&msc", "SCRL_DOWN"],
    [25, "&msc", "SCRL_DOWN"],  [26, "&mmv", "MOVE_LEFT"],  [27, "&mmv", "MOVE_DOWN"],  [28, "&mmv", "MOVE_RIGHT"],
    [31, "&mo", "warp"],        [32, "&mo", "fast"],        [33, "&mo", "slow"],
    [38, "&mo", "slow"],        [39, "&mo", "fast"],        [40, "&mo", "warp"],
    [50, "&mkp", "MCLK"],       [51, "&mkp", "LCLK"],       [52, "&mkp", "RCLK"],
    [56, "&mkp", "MCLK"],       [57, "&mkp", "LCLK"],       [58, "&mkp", "RCLK"]
  ]
};

# --- Input listener pieces. $idx holds the layer numbers: mouse, slow, fast, warp. ---
def xy($x; $y): {code: "&zip_xy_scaler", params: [$x, $y]};
def scroll($x; $y): {code: "&zip_scroll_scaler", params: [$x, $y]};
def tempMouse($idx): {code: "&zip_temp_layer", params: [$idx.mouse, 2000]};
# What a left Go60 trackpad does after scaling: flip Y, scroll with the pad, tap = right click, jump to Mouse for 2 s.
def padLeft($idx): [{code: "&zip_xy_transform", params: [["INPUT_TRANSFORM_Y_INVERT"]]}, {code: "&zip_xy_to_scroll_mapper", params: []}, {code: "&zip_click_to_right_click_mapper", params: []}, tempMouse($idx)];

# A listener with the same pointer-speed layers in each of slow, fast, warp.
def listener($idx; $code; $base; $perSpeed): {
  code: $code,
  inputProcessors: $base,
  nodes: [("slow", "fast", "warp") as $speed | {code: $speed, layers: [$idx[$speed]], inputProcessors: $perSpeed[$speed]}]
};

def listeners($idx; $go60): [
  listener($idx; "&mmv_input_listener"; []; {slow: [xy(1; 9)], fast: [xy(3; 1)], warp: [xy(12; 1)]}),
  listener($idx; "&msc_input_listener"; []; {slow: [scroll(1; 9)], fast: [scroll(3; 1)], warp: [scroll(12; 1)]})
] + (if $go60 then [
  listener($idx; "&cirque_lh_listener"; [xy(11; 12)] + padLeft($idx);
    {slow: ([xy(5; 14)] + padLeft($idx)), fast: ([xy(3; 2)] + padLeft($idx)), warp: ([xy(13; 3)] + padLeft($idx))}),
  listener($idx; "&cirque_rh_listener"; [xy(5; 2), tempMouse($idx)];
    {slow: [xy(1; 1), tempMouse($idx)], fast: [xy(4; 1), tempMouse($idx)], warp: [xy(7; 1), tempMouse($idx)]})
] else [] end);

# Add the new speed settings to the listeners the layout already has (same code), or add the whole listener.
def mergeListeners($mine): reduce $mine[] as $l (.inputListeners // [];
  (map(.code) | index($l.code)) as $at
  | if $at == null then . + [$l]
    else .[$at].nodes = ([(.[$at].nodes // [])[] | select(.code as $c | ["slow", "fast", "warp"] | index($c) | not)] + $l.nodes) end);

(.keyboard? | if type == "string" then ascii_downcase else "glove80" end) as $kb
| (.keymap // .) as $km
| ($km.layer_names // []) as $names
| [LAYERS[] | select(. as $n | $names | index($n))] as $taken
| if ($km | type) != "object" or ($km.layers | type) != "array" or ($km.layers | length) == 0 then error("This file has no layers, so there is nothing to add the mouse layers to.")
  elif ($taken | length) > 0 then . + {_flowReport: {changed: false, message: "Your layout already has a layer named \($taken | join(", ")), so nothing was changed, to keep your own edits. Rename or remove \(if ($taken | length) == 1 then "it" else "them" end) first to build the mouse layers again.", lines: [], log: ["layers already present: \($taken | join(", "))"]}}
  elif ($km.layers[0] | length) as $n | (if $kb == "go60" then ($n != 60 and $n != 62) else $n != 80 end) then error("The first layer has \($km.layers[0] | length) keys, but the \(if $kb == "go60" then "Go60 has 60 keys (plus 2 touchpad positions)" else "Glove80 has 80" end).")
  elif ($km.layers | length) + (LAYERS | length) > MAX_LAYERS then error("The mouse layers need \(LAYERS | length) free layers, and your layout has \($km.layers | length) of the \(MAX_LAYERS) allowed. Remove a layer first.")
  else
    (if $kb == "glove80" then glove80Table else go60Table end) as $table
    | ($km.layers[0] | length) as $keyCount
    | ($km.layers | length) as $first
    | {mouse: $first, slow: ($first + 1), fast: ($first + 2), warp: ($first + 3)} as $idx
    | $km.layers[0][$table.thumbAt] as $thumb
    | ($thumb.value == "&kp" and ($thumb.params // []) != []) as $upgradeThumb
    | ($km.inputListeners // [] | map(.code)) as $oldListeners
    | listeners($idx; $kb != "glove80") as $mine

    | (.keymap // .) |= (
        .layer_names = ((.layer_names // []) + LAYERS)
        | .layers = (.layers + [LAYERS[] | [range($keyCount) | {value: "&trans", params: []}]])
        | if $upgradeThumb then
            .layers[0][$table.thumbAt] = ({value: "&lt", params: [{value: $idx.mouse, params: []}, $thumb.params[0]]}
                                          + (if $thumb.decoration then {decoration: $thumb.decoration} else {} end))
          else . end
        | reduce $table.keys[] as $k (.;
            .layers[$idx.mouse][$k[0]] = {value: $k[1], params: [{value: ($idx[$k[2]] // $k[2]), params: []}]})
        | .inputListeners = mergeListeners($mine)
      )
    | . + {_flowReport: {
        changed: true,
        lines: ([{ok: true, text: "Added the layers \(LAYERS | join(", ")) (layers \($first + 1) to \($first + 4))"},
                 {ok: true, text: "Assigned \($table.keys | length) keys on the Mouse layer"}]
                + [if $upgradeThumb
                   then {ok: true, text: "Base layer key \($table.thumbAt + 1) is now a layer-tap, hold it for Mouse"}
                   else {ok: false, text: "Base layer key \($table.thumbAt + 1) is not a plain key, so it was left alone. Assign a layer-tap or toggle key to reach Mouse yourself."} end]
                + [$mine[] | .code as $c | {ok: true, text: (if ($oldListeners | index($c)) != null then "Added the speed settings to your existing \(.code)" else "Added \(.code)" end)}]),
        log: (["\($kb) layout, \($keyCount) keys per layer, new layers start at layer \($first + 1)",
               "base layer key \($table.thumbAt + 1) was \($thumb.value // "missing")"]
              + [$table.keys[] | "Mouse key \(.[0] + 1) = \(.[1]) \(.[2])"])
      }}
  end'''

category = "Mouse"

successMessage = "Mouse layers (move, scroll, click) were added. Hold your base layer thumb key to reach them (if it was not a plain key, assign a layer-tap yourself), and turn on HID_POINTING in Advanced Configuration first."

[manifest]
author = "moosyresearch"
keyboards = ["go60", "glove80"]
icon = "🖱️"
keywords = ["pointer", "cursor", "scroll", "click"]
