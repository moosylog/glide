uid = "symbols2_de"

title = "Symbol layer: German"

subtitle = "For a German keyboard language (de-DE)"

description = '''
Makes your **Symbol** layer type the right characters when your computer's keyboard language is German (de-DE).

⚠️ Add the **Symbol layer** automation first — this one needs it. (These mappings are generated automatically, not hand-verified — flag it if something looks wrong.)'''

script = '''
# ==============================================================================
#             GERMAN SYMBOL MAPPER (For MoErgo Layout Editor / ZMK)
#             OS TARGET: WINDOWS / LINUX (Standard ISO / de-DE)
# ==============================================================================

{
  # --- Punctuation & Basics ---
  "DOT":                 [{"value": "DOT", "params": []}],                                        # . -> .
  "COMMA":               [{"value": "COMMA", "params": []}],                                      # , -> ,
  "EQUAL":               [{"value": "LS", "params": [{"value": "N0", "params": []}]}],            # = -> Shift + 0

  # --- Fixed Column 4 Realignment ---
  "MINUS":               [{"value": "LS", "params": [{"value": "FSLH", "params": []}]}],          # Source Minus -> German Underscore (Shift + -)
  "UNDER":               [{"value": "FSLH", "params": []}],                                       # Source Underscore -> German Minus (- key)
  "UNDERSCORE":          [{"value": "FSLH", "params": []}],                                       
  "LS(MINUS)":           [{"value": "FSLH", "params": []}],                                       
  "PLUS":                [{"value": "RBKT", "params": []}],                                       # + -> + key (German physical RBKT)
  "LS(EQUAL)":          [{"value": "RBKT", "params": []}],

  # --- Brackets & Braces ---
  "LPAR":                [{"value": "LS", "params": [{"value": "N8", "params": []}]}],            # ( -> Shift + 8
  "LS(N9)":              [{"value": "LS", "params": [{"value": "N8", "params": []}]}],            
  "RPAR":                [{"value": "LS", "params": [{"value": "N9", "params": []}]}],            # ) -> Shift + 9
  "LS(N0)":              [{"value": "LS", "params": [{"value": "N9", "params": []}]}],            
  "LBKT":                [{"value": "RA", "params": [{"value": "N8", "params": []}]}],            # [ -> AltGr + 8
  "RBKT":                [{"value": "RA", "params": [{"value": "N9", "params": []}]}],            # ] -> AltGr + 9
  "LBRC":                [{"value": "RA", "params": [{"value": "N7", "params": []}]}],            # { -> AltGr + 7
  "LS(LBKT)":            [{"value": "RA", "params": [{"value": "N7", "params": []}]}],            
  "RBRC":                [{"value": "RA", "params": [{"value": "N0", "params": []}]}],            # } -> AltGr + 0
  "LS(RBKT)":            [{"value": "RA", "params": [{"value": "N0", "params": []}]}],            
  "LT":                  [{"value": "NON_US_BSLH", "params": []}],                                # < -> < key
  "LS(COMMA)":           [{"value": "NON_US_BSLH", "params": []}],                                
  "GT":                  [{"value": "LS", "params": [{"value": "NON_US_BSLH", "params": []}]}],   # > -> Shift + <
  "LS(DOT)":             [{"value": "LS", "params": [{"value": "NON_US_BSLH", "params": []}]}],   

  # --- Slashes & Pipes ---
  "FSLH":                [{"value": "LS", "params": [{"value": "N7", "params": []}]}],            # / -> Shift + 7
  "BSLH":                [{"value": "RA", "params": [{"value": "MINUS", "params": []}]}],         # \ -> AltGr + ß
  "PIPE":                [{"value": "RA", "params": [{"value": "NON_US_BSLH", "params": []}]}],   # | -> AltGr + <
  "LS(BSLH)":            [{"value": "RA", "params": [{"value": "NON_US_BSLH", "params": []}]}],   

  # --- Quotes & Ticks ---
  "SQT":                 [{"value": "LS", "params": [{"value": "NON_US_HASH", "params": []}]}],   # ' -> Shift + #
  "SINGLE_QUOTE":        [{"value": "LS", "params": [{"value": "NON_US_HASH", "params": []}]}],   
  "DQT":                 [{"value": "LS", "params": [{"value": "N2", "params": []}]}],            # " -> Shift + 2
  "LS(SINGLE_QUOTE)":    [{"value": "LS", "params": [{"value": "N2", "params": []}]}],            
  "LS(SQT)":             [{"value": "LS", "params": [{"value": "N2", "params": []}]}],            
  "GRAVE":               [{"value": "LS", "params": [{"value": "EQUAL", "params": []}]}],         # ` -> Shift + ´

  # --- Special Symbols (Number Row & Misc) ---
  "EXCLM":               [{"value": "LS", "params": [{"value": "N1", "params": []}]}],            # ! -> Shift + 1
  "LS(N1)":              [{"value": "LS", "params": [{"value": "N1", "params": []}]}],            
  "AT":                  [{"value": "RA", "params": [{"value": "Q", "params": []}]}],             # @ -> AltGr + Q
  "LS(N2)":              [{"value": "RA", "params": [{"value": "Q", "params": []}]}],             
  "HASH":                [{"value": "NON_US_HASH", "params": []}],                                # # -> # key
  "LS(N3)":              [{"value": "NON_US_HASH", "params": []}],                                
  "DLLR":                [{"value": "LS", "params": [{"value": "N4", "params": []}]}],            # $ -> Shift + 4
  "LS(N4)":              [{"value": "LS", "params": [{"value": "N4", "params": []}]}],            
  "PRCNT":               [{"value": "LS", "params": [{"value": "N5", "params": []}]}],            # % -> Shift + 5
  "LS(N5)":              [{"value": "LS", "params": [{"value": "N5", "params": []}]}],            
  "CARET":               [{"value": "GRAVE", "params": []}],                                      # ^ -> ^ key (top left)
  "LS(N6)":              [{"value": "GRAVE", "params": []}],                                      
  "AMPS":                [{"value": "LS", "params": [{"value": "N6", "params": []}]}],            # & -> Shift + 6
  "LS(N7)":              [{"value": "LS", "params": [{"value": "N6", "params": []}]}],            
  "STAR":                [{"value": "LS", "params": [{"value": "RBKT", "params": []}]}],          # * -> Shift + +
  "LS(N8)":              [{"value": "LS", "params": [{"value": "RBKT", "params": []}]}],          
  "TILDE":               [{"value": "RA", "params": [{"value": "RBKT", "params": []}]}],          # ~ -> AltGr + +
  "LS(GRAVE)":           [{"value": "RA", "params": [{"value": "RBKT", "params": []}]}],          
  "QMARK":               [{"value": "LS", "params": [{"value": "MINUS", "params": []}]}],         # ? -> Shift + ß
  "LS(FSLH)":            [{"value": "LS", "params": [{"value": "MINUS", "params": []}]}],         
  "COLON":               [{"value": "LS", "params": [{"value": "DOT", "params": []}]}],           # : -> Shift + .
  "LS(SEMI)":            [{"value": "LS", "params": [{"value": "DOT", "params": []}]}],           
  "SEMI":                [{"value": "LS", "params": [{"value": "COMMA", "params": []}]}]          # ; -> Shift + ,
} as $table |

# ==============================================================================
# HOW IT WORKS
# The table above says: "when the Symbol layer has this US key, press that key
# instead", so the layer types the same characters on a different OS keyboard
# language. Only plain &kp keys are looked at. Everything else (macros, layer
# switches, empty keys) and every key not in the table stays exactly as it is.
# The layer is found by its name, "Symbol" (added by the "Symbol layer" automation).
# ==============================================================================

"Symbol" as $layerName
| "de-DE" as $locale
| "German" as $language

# The key a binding presses, written the way the table spells it: "N9", or "LS(N9)" for Shift+9.
| def keyName: .params[0] | if (.params // []) == [] then .value else "\(.value)(\(.params[0].value))" end;
  def isKp: . != null and .value == "&kp" and (.params // []) != [];
  def translate: if isKp and $table[keyName] then .params = $table[keyName] else . end;
  def describe: if isKp then keyName else (.value // "empty") end;
(.keymap // .) as $km
| if ($km | type) != "object" or ($km.layer_names | type) != "array" or ($km.layers | type) != "array"
  then error("This file has no layers, so there is nothing to translate.") else . end
| ($km.layer_names | index($layerName)) as $at
| if $at == null then error("There is no layer named \"\($layerName)\". Run the Symbol layer automation first, or rename your layer to Symbol.") else . end

| $km.layers[$at] as $before
| ($before | map(translate)) as $after
| [range($before | length) | select($before[.] != $after[.])] as $changedAt
| .locale as $was
| if ($changedAt | length) == 0 and $was == $locale
  then . + {_flowReport: {changed: false, message: "No key on your Symbol layer needed changing for \($language), so nothing was changed.", lines: [], log: ["0 of \($before | length) keys matched the \($language) table"]}}
  else
    (.keymap // .) |= (.layers[$at] = $after)
    | .locale = $locale
    | . + {_flowReport: {
        changed: true,
        message: "Updated \($changedAt | length) keys on your Symbol layer for \($language). Your layout language is now \($locale).",
        lines: ([{ok: true, text: "\($changedAt | length) keys changed on the Symbol layer"}]
                + (if $was == $locale and ($changedAt | length) > 0
                   then [{ok: false, text: "Your layout language was already \($locale), so this may have been applied before. If the symbols look wrong, use Undo."}]
                   elif $was != null and $was != "en-US" and $was != $locale and ($changedAt | length) > 0
                   then [{ok: false, text: "Your layout language was already \($was), so the Symbol layer may have been translated for it before. If the symbols look wrong, use Undo."}]
                   else [] end)),
        log: (["Symbol layer is layer \($at + 1) of \($km.layers | length)", "\($changedAt | length) of \($before | length) keys matched the \($language) table"]
              + [$changedAt[] | "key \(. + 1): \($before[.] | describe) -> \($after[.] | describe)"])
      }}
  end'''

category = "Language tweaks"

successMessage = "Your Symbol layer's punctuation now matches what a German (de-DE) OS layout actually produces for each key."

[manifest]
author = "moosyresearch"
keyboards = ["go60", "glove80"]
icon = "🇩🇪"
keywords = ["german", "deutsch", "qwertz"]
