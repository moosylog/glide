uid = "mouse_swap_trackpads"

title = "Swap Trackpads"

subtitle = "Swap Left & Right Trackpads"

description = '''
Swaps which trackpad does what — the one that was your mouse pointer becomes the scroll wheel, and vice versa. Run again to swap back.'''

script = '''
(.keymap // .) |= (
  # Check if inputListeners exists and is an array
  if .inputListeners and (.inputListeners | type == "array") then
    .inputListeners |= map(
      # If this config block targets the Left Hand, point it to the Right Hand
      if .code == "&cirque_lh_listener" then
        .code = "&cirque_rh_listener"
        
      # If this config block targets the Right Hand, point it to the Left Hand
      elif .code == "&cirque_rh_listener" then
        .code = "&cirque_lh_listener"
        
      # Leave any other custom listeners (like trackballs) untouched
      else
        .
      end
    )
  else
    .
  end
)'''

category = "Mouse Controls"

successMessage = "Your two trackpads have swapped roles — whichever hand was the mouse pointer is now the scroll wheel, and vice versa. Run again to swap back."

[manifest]
author = "moosyresearch"
keyboards = ["glove80", "go60"]
icon = "⚫"
