uid = "symbols2_fr"

title = "Symbol layer: French"

subtitle = "For a French AZERTY keyboard language (fr-FR)"

description = '''
Makes your **Symbol** layer type the right characters when your computer's keyboard language is French AZERTY (fr-FR).

⚠️ Add the **Symbol layer** automation first — this one needs it. (These mappings are generated automatically, not hand-verified — flag it if something looks wrong.)'''

script = '''
# ==============================================================================
#             FRENCH SYMBOL MAPPER (For MoErgo Layout Editor / ZMK)
#             OS TARGET: WINDOWS / LINUX (Standard ISO / fr-FR)
# ==============================================================================
# 
# WELCOME! This script translates your "Symbol" layer keys for a French AZERTY OS.
# Maps aliases (e.g., SQT/SINGLE_QUOTE) to prevent any normalization bugs.
# ==============================================================================

{
  # --- Punctuation & Basics ---
  "DOT":                 [{"value": "LS", "params": [{"value": "COMMA", "params": []}]}],         # . -> Shift + ; key (US COMMA position)
  "COMMA":               [{"value": "M", "params": []}],                                          # , -> , key (US M position)
  "MINUS":               [{"value": "N6", "params": []}],                                         # - -> - key (US N6)
  "EQUAL":               [{"value": "EQUAL", "params": []}],                                      # = -> = key (US EQUAL)

  # --- Brackets & Braces ---
  "LPAR":                [{"value": "N5", "params": []}],                                         # ( -> ( key (US N5)
  "LS(N9)":              [{"value": "N5", "params": []}],            
  "RPAR":                [{"value": "MINUS", "params": []}],                                      # ) -> ) key (US MINUS position)
  "LS(N0)":              [{"value": "MINUS", "params": []}],            
  "LBKT":                [{"value": "RA", "params": [{"value": "N5", "params": []}]}],            # [ -> AltGr + 5
  "RBKT":                [{"value": "RA", "params": [{"value": "MINUS", "params": []}]}],          # ] -> AltGr + ) (US MINUS position)
  "LBRC":                [{"value": "RA", "params": [{"value": "N4", "params": []}]}],            # { -> AltGr + 4
  "LS(LBKT)":            [{"value": "RA", "params": [{"value": "N4", "params": []}]}],            
  "RBRC":                [{"value": "RA", "params": [{"value": "EQUAL", "params": []}]}],          # } -> AltGr + = (US EQUAL position)
  "LS(RBKT)":            [{"value": "RA", "params": [{"value": "EQUAL", "params": []}]}],            
  "LT":                  [{"value": "NON_US_BSLH", "params": []}],                                # < -> < key (next to L-Shift)
  "LS(COMMA)":           [{"value": "NON_US_BSLH", "params": []}],                                
  "GT":                  [{"value": "LS", "params": [{"value": "NON_US_BSLH", "params": []}]}],   # > -> Shift + <
  "LS(DOT)":             [{"value": "LS", "params": [{"value": "NON_US_BSLH", "params": []}]}],   

  # --- Slashes & Pipes ---
  "FSLH":                [{"value": "LS", "params": [{"value": "DOT", "params": []}]}],           # / -> Shift + : key (US DOT position)
  "BSLH":                [{"value": "RA", "params": [{"value": "N8", "params": []}]}],            # \ -> AltGr + 8
  "PIPE":                [{"value": "RA", "params": [{"value": "N6", "params": []}]}],            # | -> AltGr + 6
  "LS(BSLH)":            [{"value": "RA", "params": [{"value": "N6", "params": []}]}],   

  # --- Quotes & Ticks ---
  "SQT":                 [{"value": "N4", "params": []}],                                         # ' -> ' key (US N4)
  "SINGLE_QUOTE":        [{"value": "N4", "params": []}],                                  
  "DQT":                 [{"value": "N3", "params": []}],                                         # " -> " key (US N3)
  "LS(SINGLE_QUOTE)":    [{"value": "N3", "params": []}],            
  "LS(SQT)":             [{"value": "N3", "params": []}],            
  "GRAVE":               [{"value": "RA", "params": [{"value": "N7", "params": []}]}],            # ` -> AltGr + 7

  # --- Special Symbols ---
  "EXCLM":               [{"value": "FSLH", "params": []}],                                       # ! -> ! key (US FSLH position)
  "LS(N1)":              [{"value": "FSLH", "params": []}],            
  "AT":                  [{"value": "RA", "params": [{"value": "N0", "params": []}]}],            # @ -> AltGr + 0
  "LS(N2)":              [{"value": "RA", "params": [{"value": "N0", "params": []}]}],             
  "HASH":                [{"value": "RA", "params": [{"value": "N3", "params": []}]}],            # # -> AltGr + 3
  "LS(N3)":              [{"value": "RA", "params": [{"value": "N3", "params": []}]}],                                
  "DLLR":                [{"value": "RBKT", "params": []}],                                       # $ -> $ key (US RBKT position)
  "LS(N4)":              [{"value": "RBKT", "params": []}],            
  "PRCNT":               [{"value": "LS", "params": [{"value": "SQT", "params": []}]}],           # % -> Shift + ù key (US SQT position)
  "LS(N5)":              [{"value": "LS", "params": [{"value": "SQT", "params": []}]}],            
  "CARET":               [{"value": "LBKT", "params": []}],                                       # ^ -> ^ key (US LBKT dead key)
  "LS(N6)":              [{"value": "LBKT", "params": []}],                                      
  "AMPS":                [{"value": "N1", "params": []}],                                         # & -> & key (US N1)
  "LS(N7)":              [{"value": "N1", "params": []}],            
  "STAR":                [{"value": "BSLH", "params": []}],                                       # * -> * key (US BSLH position)
  "LS(N8)":              [{"value": "BSLH", "params": []}],          
  "TILDE":               [{"value": "RA", "params": [{"value": "N2", "params": []}]}],            # ~ -> AltGr + 2
  "LS(GRAVE)":           [{"value": "RA", "params": [{"value": "N2", "params": []}]}],          
  "UNDER":               [{"value": "N8", "params": []}],                                         # _ -> _ key (US N8)
  "UNDERSCORE":          [{"value": "N8", "params": []}],          
  "LS(MINUS)":           [{"value": "N8", "params": []}],          
  "QMARK":               [{"value": "LS", "params": [{"value": "M", "params": []}]}],             # ? -> Shift + , key (US M position)
  "LS(FSLH)":            [{"value": "LS", "params": [{"value": "M", "params": []}]}],         
  "COLON":               [{"value": "DOT", "params": []}],                                        # : -> : key (US DOT position)
  "LS(SEMI)":            [{"value": "DOT", "params": []}],           
  "SEMI":                [{"value": "COMMA", "params": []}]                                       # ; -> ; key (US COMMA position)
} as $table |

# ==============================================================================
# HOW IT WORKS
# The table above says: "when the Symbol layer has this US key, press that key
# instead", so the layer types the same characters on a different OS keyboard
# language. Only plain &kp keys are looked at. Everything else (macros, layer
# switches, empty keys) and every key not in the table stays exactly as it is.
# The layer is found by its name, "Symbol" (added by the "Symbol layer" automation).
# ==============================================================================

"Symbol" as $layerName
| "fr-FR-AZERTY" as $locale
| "French (AZERTY)" as $language

# The key a binding presses, written the way the table spells it: "N9", or "LS(N9)" for Shift+9.
| def keyName: .params[0] | if (.params // []) == [] then .value else "\(.value)(\(.params[0].value))" end;
  def isKp: . != null and .value == "&kp" and (.params // []) != [];
  def translate: if isKp and $table[keyName] then .params = $table[keyName] else . end;
  def describe: if isKp then keyName else (.value // "empty") end;
(.keymap // .) as $km
| if ($km | type) != "object" or ($km.layer_names | type) != "array" or ($km.layers | type) != "array"
  then error("This file has no layers, so there is nothing to translate.") else . end
| ($km.layer_names | index($layerName)) as $at
| if $at == null then error("There is no layer named \"\($layerName)\". Run the Symbol layer automation first, or rename your layer to Symbol.") else . end

| $km.layers[$at] as $before
| ($before | map(translate)) as $after
| [range($before | length) | select($before[.] != $after[.])] as $changedAt
| .locale as $was
| if ($changedAt | length) == 0 and $was == $locale
  then . + {_flowReport: {changed: false, message: "No key on your Symbol layer needed changing for \($language), so nothing was changed.", lines: [], log: ["0 of \($before | length) keys matched the \($language) table"]}}
  else
    (.keymap // .) |= (.layers[$at] = $after)
    | .locale = $locale
    | . + {_flowReport: {
        changed: true,
        message: "Updated \($changedAt | length) keys on your Symbol layer for \($language). Your layout language is now \($locale).",
        lines: ([{ok: true, text: "\($changedAt | length) keys changed on the Symbol layer"}]
                + (if $was == $locale and ($changedAt | length) > 0
                   then [{ok: false, text: "Your layout language was already \($locale), so this may have been applied before. If the symbols look wrong, use Undo."}]
                   elif $was != null and $was != "en-US" and $was != $locale and ($changedAt | length) > 0
                   then [{ok: false, text: "Your layout language was already \($was), so the Symbol layer may have been translated for it before. If the symbols look wrong, use Undo."}]
                   else [] end)),
        log: (["Symbol layer is layer \($at + 1) of \($km.layers | length)", "\($changedAt | length) of \($before | length) keys matched the \($language) table"]
              + [$changedAt[] | "key \(. + 1): \($before[.] | describe) -> \($after[.] | describe)"])
      }}
  end'''

category = "Language tweaks"

successMessage = "Your Symbol layer's punctuation now matches what a French AZERTY (fr-FR) OS layout actually produces for each key."

[manifest]
author = "moosyresearch"
keyboards = ["go60", "glove80"]
icon = "🇫🇷"
keywords = ["french", "azerty", "francais"]
