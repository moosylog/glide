category = "Smart Modifiers"

successMessage = "Bilateral HRM is live on your Go60's new 'HRM_Bil' layer, with 8 per-finger layers and their macros/hold-taps behind it. Set HRM_Bil as your base layer (or switch to it) to use it, and give the new timing a few days before retuning."

[manifest]
author = "moosyresearch"
keyboards = ["go60"]
icon = "📦"

[[param]]
id = "mod_preset"
label = "Recommended order"
type = "select"
options = ["GACS", "CAGS"]
labels = ["Windows / Linux", "macOS"]
default = "GACS"
