uid = "hrm_bil60"

title = "Go60 Bilateral HRM"

subtitle = "Sunaku's Bilateral Home-Row Mods for Go60"

description = '''
The advanced Sunaku-style Home-Row Mods, ported to the Go60 — with per-finger layers so two modifiers on the same hand can't misfire together.

Builds a brand-new **HRM_Bil** base layer (standard QWERTY plus the 8 home-row mods) plus 8 finger layers and their macros/hold-taps — a lot at once, and it replaces whatever is on your base layer now.

⚠️ If you already have home-row mods, remove them first with the **Remove HRMs** automation.'''

script = '''
{
  "GACS": { "L1": "LGUI",  "R1": "RGUI",  "L2": "LCTRL", "R2": "RCTRL", "C1": "#d9f9c9", "C2":"#fbe6fe"  },
  "CAGS": { "L1": "LCTRL", "R1": "RCTRL", "L2": "LGUI",  "R2": "RGUI",  "C1": "#fbe6fe", "C2":"#d9f9c9"  }
}[$mod_preset] as $mod |

[6,7,8,9,10,11,18,19,20,21,22,23,30,31,32,33,34,35,42,43,44,45,46,47,51,52,53,54,55,56,57,58,59] as $l_trigs |
[0,1,2,3,4,5,12,13,14,15,16,17,24,25,26,27,28,29,36,37,38,39,40,41,48,49,50,54,55,56,57,58,59] as $r_trigs |

"HRM_Bil" as $LYR |

# ZMK Name-Aware Injection -- Go60 port of Sunaku's Bilateral HRM (hrm_bil80)
(if .keymap then .keymap else . end) |= (

  # 1. Guarantee all layers exist so we can dynamically grab their indices
  (
    ["HRM_Bil","LeftPinky","LeftRingy","LeftMiddy","LeftIndex","RightIndex","RightMiddy","RightRingy","RightPinky"] as $req_layers |
    .layer_names |= (. // []) |
    .layers |= (. // []) |
    reduce $req_layers[] as $name (.;
      if (.layer_names | index($name) == null) then
        .layer_names += [$name] |
        .layers += [[]]
      else . end
    )
  ) |

  # 2. Capture their dynamic index values
  (.layer_names | index("HRM_Bil")) as $idx_hrm |
  (.layer_names | index("LeftPinky")) as $idx_lp |
  (.layer_names | index("LeftRingy")) as $idx_lr |
  (.layer_names | index("LeftMiddy")) as $idx_lm |
  (.layer_names | index("LeftIndex")) as $idx_li |
  (.layer_names | index("RightIndex")) as $idx_ri |
  (.layer_names | index("RightMiddy")) as $idx_rm |
  (.layer_names | index("RightRingy")) as $idx_rr |
  (.layer_names | index("RightPinky")) as $idx_rp |

  # 3. Inject Hold-Taps (Go60 bilateral trigger sets from hrm_add.flows)
  .holdTaps = [{"name":"&HRM_left_pinky_v1B_TKZ","description":"HRM_left_pinky_bilateral - &HRM_left_pinky_hold -> &kp - Go60 port","bindings":["&HRM_left_pinky_hold_v1B_TKZ","&kp"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_pinky_ring_v1B_TKZ","description":"HRM_left_pinky_ring_bilateral -> &kp -> &HRM_left_pinky_tap - Go60 port","bindings":["&kp","&HRM_left_pinky_tap_v1B_TKZ"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_pinky_middy_v1B_TKZ","description":"HRM_left_pinky_middy_bilateral -> &kp -> &HRM_left_pinky_tap - Go60 port","bindings":["&kp","&HRM_left_pinky_tap_v1B_TKZ"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_pinky_index_v1B_TKZ","description":"HRM_left_pinky_index_bilateral -> &kp -> &HRM_left_pinky_tap - Go60 port","bindings":["&kp","&HRM_left_pinky_tap_v1B_TKZ"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_ring_v1B_TKZ","description":"HRM_left_ring_bilateral - &HRM_left_ring_hold -> &kp - Go60 port","bindings":["&HRM_left_ring_hold_v1B_TKZ","&kp"],"tappingTermMs":240,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":100,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_ring_pinky_v1B_TKZ","description":"HRM_left_ring_pinky_bilateral -> &kp -> &HRM_left_ring_tap - Go60 port","bindings":["&kp","&HRM_left_ring_tap_v1B_TKZ"],"tappingTermMs":240,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":100,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_ring_middy_v1B_TKZ","des