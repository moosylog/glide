)

# --- REPORT ---
| (if type == "object" and .keymap? then .keymap else . end) as $after
| ($after.layer_names | index("LeftPinky")) as $first
| ([fingers[] | select(($before.layers[0][.at] | tapKeyOf) == null)]) as $skipped
| (($before.layer_names // []) | index("LeftPinky") != null) as $wasThere
| (($before.layer_names // []) | index("HRM_Bil") != null) as $oldLayer
| ([.custom_defined_behaviors, .custom_devicetree | select(type == "string" and test("\\S"))] | length > 0) as $hasCode
| if $wasThere and $before == $after
  then . + {_flowReport: {changed: false, message: "Nothing was changed. The home-row mods and the 8 finger layers are already set up this way.", lines: [], log: ["identical to the layout before"]}}
  else . + {_flowReport: {
    changed: true,
    lines: ([{ok: true, text: "Put home-row mods on \(8 - ($skipped | length)) of the 8 home-row keys of your base layer"},
             {ok: true, text: (if $wasThere then "Rebuilt the 8 finger layers (layers \($first + 1) to \($first + 8)) from your base layer" else "Added the 8 finger layers (layers \($first + 1) to \($first + 8)) right after your base layer" end)},
             {ok: true, text: "Added the hold-taps and macros they use (your layout now has \($after.holdTaps | length) hold-taps and \($after.macros | length) macros)"}]
            + (if ($skipped | length) > 0 then [{ok: false, text: "\($skipped | length) home-row keys were left as they are because they are not plain keys (key \($skipped | map(.at + 1 | tostring) | join(", "))). Their finger layers were still added."}] else [] end)
            + (if $hasCode and ($wasThere | not) then [{ok: false, text: "Your layout has custom code (Custom Defined Behaviors or Custom Devicetree). If it uses layer numbers instead of layer names, check them, because every layer after your base layer moved up by 8."}] else [] end)
            + (if $oldLayer then [{ok: false, text: "Your layout still has the HRM_Bil layer from an earlier version of this automation. It is not used any more, and you can delete it."}] else [] end)),
    log: ["layers: \($before.layers | length) before, \($after.layers | length) after", "finger layers start at layer \($first + 1)"]
  }}
  end'''

category = "Modifier keys"

successMessage = "Advanced home-row mods are ready. The 8 finger layers were added right after your base layer, and the home-row mods are on your base layer's home row. Give the timing a few days before you fine-tune it."

[manifest]
author = "moosyresearch"
keyboards = ["go60"]
icon = "📦"
advanced = true
keywords = ["bilateral", "sunaku", "hrm", "home row", "per finger"]

[[param]]
id = "mod_preset"
label = "Modifier order"
type = "select"
options = ["GACS", "CAGS"]
labels = ["Windows / Linux", "macOS"]
default = "GACS"

[[param]]
id = "set_decorators"
label = "Color the home-row keys by modifier"
type = "boolean"
default = true
