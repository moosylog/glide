uid = "hrm_bil60"

title = "Advanced Home-row mods, Bilateral"

subtitle = "Per-finger layers for Go60 (Sunaku)"

description = '''
Home-row mods with extra protection: per-finger layers stop two modifiers on the same hand from misfiring together. [Learn more](https://sites.google.com/view/keyboards/layout/homerow-mods-explained).

Works with the letters you already have on your base layer (QWERTY, Colemak, Dvorak, Enthium ...): the home-row mods go on its home row (colored by modifier when **Color the home-row keys by modifier** is on), and 8 finger layers are added right after it, built from the same letters. It also adds the hold-taps and macros they use — a lot at once.

⚠️ If you already have home-row mods, remove them first with **Remove home-row mods**.'''

script = '''
# ==============================================================================
# ADVANCED HOME-ROW MODS, BILATERAL (Go60)
# ==============================================================================
# Puts the home-row mods on the home row of the first layer (the keys it already has, so any alpha
# layout works), adds 8 finger layers right after the first layer, built from the same keys, and
# adds the hold-taps and macros they use. Hold-taps and macros of yours are kept; one with the same
# name as one of these is replaced.
#
# Adding layers after the first one moves every later layer up by 8, so the layer numbers on your
# keys, combos, trackpad settings, your own layer hold-taps and macros are moved with them.
# Running it again rebuilds the 8 finger layers where they are.
#
# It stops, and changes nothing, when the file has no layers, its first layer does not have the
# right number of keys, the 8 layers do not fit within the 32 allowed, the home row already has
# other home-row mods, or only some of the finger layers exist.
# ==============================================================================

def MAX_LAYERS: 32;
def FINGERS: ["LeftPinky", "LeftRingy", "LeftMiddy", "LeftIndex", "RightIndex", "RightMiddy", "RightRingy", "RightPinky"];

# Puts the new items in the list; an item with the same name is replaced, the others stay in place.
def put_all($new):
  (. // []) as $have
  | ($have | map(select(.name as $n | ($new | map(.name) | index($n)) == null))) + $new;

# --- Where the keys are on this keyboard (positions on the first layer, counting from 0) ---
def LEFT_HOME: [25, 26, 27, 28];
def RIGHT_HOME: [31, 32, 33, 34];
def LEFT_TAP: [0, 1, 2, 3, 4, 5, 13, 14, 15, 16, 17, 29, 37, 38, 39, 40, 41];
def RIGHT_TAP: [6, 7, 8, 9, 10, 11, 18, 19, 20, 21, 22, 30, 42, 43, 44, 45, 46];
def RING_RIGHT: "LALT";

# The eight fingers: the finger layer, the hand, the finger, and the home-row position of its key.
def fingers: [
  {layer: "LeftPinky",  hand: "left",  f: "pinky", at: LEFT_HOME[0]},
  {layer: "LeftRingy",  hand: "left",  f: "ring",  at: LEFT_HOME[1]},
  {layer: "LeftMiddy",  hand: "left",  f: "middy", at: LEFT_HOME[2]},
  {layer: "LeftIndex",  hand: "left",  f: "index", at: LEFT_HOME[3]},
  {layer: "RightIndex", hand: "right", f: "index", at: RIGHT_HOME[0]},
  {layer: "RightMiddy", hand: "right", f: "middy", at: RIGHT_HOME[1]},
  {layer: "RightRingy", hand: "right", f: "ring",  at: RIGHT_HOME[2]},
  {layer: "RightPinky", hand: "right", f: "pinky", at: RIGHT_HOME[3]}
];

# The modifier on each finger. The pinky and middle finger follow the chosen order.
def modOf($mod; $r):
  if $r.f == "pinky" then (if $r.hand == "left" then $mod.L1 else $mod.R1 end)
  elif $r.f == "middy" then (if $r.hand == "left" then $mod.L2 else $mod.R2 end)
  elif $r.f == "ring" then (if $r.hand == "left" then "LALT" else RING_RIGHT end)
  else (if $r.hand == "left" then "LSHFT" else "RSHFT" end) end;

# The key colour for each modifier (the same colours as the normal home-row mods automation).
def colorOf($m): {"LSHFT": "#fffec9", "RSHFT": "#fffec9", "LCTRL": "#d9f9c9", "RCTRL": "#d9f9c9", "LALT": "#e5feff", "RALT": "#e5feff", "LGUI": "#fbe6fe", "RGUI": "#fbe6fe"}[$m];

def homeName($r): "&HRM_\($r.hand)_\($r.f)_v1B_TKZ";
def tapName($r): "&HRM_\($r.hand)_\($r.f)_tap_v1B_TKZ";
def neighborName($r; $g): "&HRM_\($r.hand)_\($r.f)_\($g.f)_v1B_TKZ";

# The key a base layer key types, or null when it is not a plain key press. A home-row key that
# already has these home-row mods gives back the key it types when tapped.
def tapKeyOf:
  if . == null then null
  elif (.value | type) == "string" and (.value | test("^&HRM_(left|right)_(pinky|ring|middy|index)_v1B_TKZ$")) and ((.params // []) | length) == 2 then .params[1]
  elif .value == "&kp" and ((.params // []) | length) > 0 then .params[0]
  else null end;

# One finger layer, built from the base layer. The hand of the finger gets plain taps (and the other
# fingers' home-row mods), the other hand's home row types its plain letters, everything else falls
# through to the layer below. Keys that are not plain key presses are copied as they are.
def buildLayer($r; $base; $mod):
  (if $r.hand == "left" then LEFT_HOME else RIGHT_HOME end) as $own
  | (if $r.hand == "left" then RIGHT_HOME else LEFT_HOME end) as $other
  | (if $r.hand == "left" then LEFT_TAP else RIGHT_TAP end) as $taps
  | [range(0; $base | length) as $p
     | $base[$p] as $b
     | ($b | tapKeyOf) as $k
     | if $p == $r.at then {value: "&none"}
       elif ($own | index($p)) != null then
         (fingers | map(select(.at == $p))[0]) as $g
         | (if $k == null then $b else {value: neighborName($r; $g), params: [{value: modOf($mod; $g)}, $k]} end)
       elif ($other | index($p)) != null then (if $k == null then $b else {value: "&kp", params: [$k]} end)
       elif ($taps | index($p)) != null then (if $k == null then $b else {value: tapName($r), params: [$k]} end)
       else {value: "&trans"} end];

# --- Moving layer numbers when the finger layers are inserted after the base layer ---
# Layer keys are the ZMK ones (mo, to, tog, sl, lt), your own hold-taps that start with one of them,
# and macros that pass one of their own parameters to one of them. Name -> positions of the layer number.
def layer_params:
  . as $km
  | {"mo": [0], "to": [0], "tog": [0], "sl": [0], "lt": [0]} as $zmk
  | reduce (($km.holdTaps // [])[] | select(.name != null)) as $h ($zmk;
      ([($h.bindings // []) | to_entries[] | select(.value | ltrimstr("&") | IN("mo", "to", "tog", "sl", "lt")) | .key]) as $at
      | if ($at | length) > 0 then .[$h.name | ltrimstr("&")] = $at else . end)
  | reduce (($km.macros // [])[] | select(.name != null)) as $m (.;
      ([range(0; (($m.bindings // []) | length) - 1) as $i
        | $m.bindings[$i] as $a | $m.bindings[$i + 1] as $b
        | select(($a.value // "") | startswith("&macro_param_"))
        | select(($b.value // "") | ltrimstr("&") | IN("mo", "to", "tog", "sl", "lt"))
        | (($a.value | ltrimstr("&macro_param_") | .[0:1] | tonumber) - 1)] | unique) as $at
      | if ($at | length) > 0 then .[$m.name | ltrimstr("&")] = $at else . end);

# Layer numbers are usually numbers, but some layouts store them as text ("2").
def shiftUp($n):
  if type == "number" then (if . >= 1 then . + $n else . end)
  elif type == "string" and test("^[0-9]+$") then (tonumber | (if . >= 1 then . + $n else . end) | tostring)
  else . end;

# Moves the layer number of every layer key anywhere in the file (see layer_params above). $lp says where the layer number sits.
def moveRefs($lp; f):
  reduce path(..
      | select(type == "object" and (.value | type) == "string" and (.params | type) == "array" and $lp[.value | ltrimstr("&")] != null)) as $p
    (.; (getpath($p).value | ltrimstr("&")) as $name
      | reduce $lp[$name][] as $i (.;
          if (getpath($p + ["params", $i]) | type) == "object" and (getpath($p + ["params", $i]) | has("value"))
          then setpath($p + ["params", $i, "value"]; getpath($p + ["params", $i, "value"]) | f) else . end));

def shift_refs($n):
  layer_params as $lp
  | moveRefs($lp; shiftUp($n))
  | .combos[]? |= (if (.layers | type) == "array" then .layers |= map(shiftUp($n)) else . end)
  | .inputListeners[]?.nodes[]? |= (if (.layers | type) == "array" then .layers |= map(shiftUp($n)) else . end);

# The layout as it is now, to tell afterwards what changed.
(if type == "object" and .keymap? then .keymap else . end) as $before |

{
  "GACS": { "L1": "LGUI",  "R1": "RGUI",  "L2": "LCTRL", "R2": "RCTRL" },
  "CAGS": { "L1": "LCTRL", "R1": "RCTRL", "L2": "LGUI",  "R2": "RGUI"  }
}[$mod_preset] as $mod |
[6,7,8,9,10,11,18,19,20,21,22,23,30,31,32,33,34,35,42,43,44,45,46,47,51,52,53,54,55,56,57,58,59] as $l_trigs |
[0,1,2,3,4,5,12,13,14,15,16,17,24,25,26,27,28,29,36,37,38,39,40,41,48,49,50,54,55,56,57,58,59] as $r_trigs |

(if .keymap then .keymap else . end) |= (

  # 0. Checks: stop before changing anything
  (if (.layers | type) != "array" or (.layers | length) == 0
   then error("This file has no layers, so there is nothing to build the home-row mods on.")
   else . end) |
  (if ((.layer_names // []) | length) != (.layers | length)
   then error("The layer names and the layers of this file do not match, so it can't be changed safely.")
   else . end) |
  ((.layers[0] | length) as $n
   | if $n != 60 and $n != 62
     then error("The first layer has \($n) keys, but the Go60 has 60 keys (plus 2 touchpad positions).")
     else . end) |
  ((LEFT_HOME + RIGHT_HOME) as $homes
   | if [$homes[] as $p | .layers[0][$p] | select(.value != null and (.value | startswith("&HRM_")) and ((. | tapKeyOf) == null))] | length > 0
     then error("Your home row already has other home-row mods. Run Remove home-row mods first, then run this again.")
     else . end) |
  ((.layer_names // []) as $names | [FINGERS[] | select(. as $n | $names | index($n) != null)]) as $present |
  (if ($present | length) != 0 and ($present | length) != 8
   then error("Some of the finger layers exist (\($present | join(", "))) but not all 8, so they can't be rebuilt safely. Run Remove home-row mods first, then run this again.")
   else . end) |
  (($present | length) == 8) as $rerun |
  (if $rerun then 0 else 8 end) as $adding |
  (if (.layers | length) + $adding > MAX_LAYERS
   then error("The home-row mods need 8 more layers, but your layout has only \(MAX_LAYERS - (.layers | length)) of the \(MAX_LAYERS) allowed left. Remove a layer first.")
   else . end) |

  # 1. Make room right after the base layer: every layer after it moves up by 8, and so does every key,
  #    combo and trackpad setting that points at one of them.
  (if $rerun then . else shift_refs(8) end) |

  # 2. Build the finger layers from the base layer, and remember which home-row keys can take a mod.
  (.layers[0]) as $base |
  (fingers | map({key: .layer, value: buildLayer(.; $base; $mod)}) | from_entries) as $built |
  (if $rerun
   then reduce FINGERS[] as $n (.; .layers[.layer_names | index($n)] = $built[$n])
   else .layer_names = ([.layer_names[0]] + FINGERS + .layer_names[1:]) | .layers = ([.layers[0]] + [FINGERS[] as $n | $built[$n]] + .layers[1:])
   end) |

  # 3. Put the home-row mods on the base layer's home row.
  reduce fingers[] as $r (.;
    ($base[$r.at]) as $b
    | ($b | tapKeyOf) as $k
    | if $k == null then .
      else .layers[0][$r.at] = ({value: homeName($r), params: [{value: modOf($mod; $r)}, $k]}
                                + (if $set_decorators and colorOf(modOf($mod; $r)) != null then {decoration: {background: colorOf(modOf($mod; $r))}}
                                   elif $b.decoration then {decoration: $b.decoration} else {} end))
      end) |

  # 4. Where the finger layers are now
  (.layer_names | index("LeftPinky")) as $idx_lp |
  (.layer_names | index("LeftRingy")) as $idx_lr |
  (.layer_names | index("LeftMiddy")) as $idx_lm |
  (.layer_names | index("LeftIndex")) as $idx_li |
  (.layer_names | index("RightIndex")) as $idx_ri |
  (.layer_names | index("RightMiddy")) as $idx_rm |
  (.layer_names | index("RightRingy")) as $idx_rr |
  (.layer_names | index("RightPinky")) as $idx_rp |

  # The key each home-row finger types on the base layer; the tap macros type it first (a stock letter if it is not a plain key)
  (fingers[] | select(.hand == "left" and .f == "pinky")) as $f_left_pinky | (($base[$f_left_pinky.at] | tapKeyOf) // {"value":"A"}) as $tk_left_pinky |
  (fingers[] | select(.hand == "left" and .f == "ring")) as $f_left_ring | (($base[$f_left_ring.at] | tapKeyOf) // {"value":"S"}) as $tk_left_ring |
  (fingers[] | select(.hand == "left" and .f == "middy")) as $f_left_middy | (($base[$f_left_middy.at] | tapKeyOf) // {"value":"D"}) as $tk_left_middy |
  (fingers[] | select(.hand == "left" and .f == "index")) as $f_left_index | (($base[$f_left_index.at] | tapKeyOf) // {"value":"F"}) as $tk_left_index |
  (fingers[] | select(.hand == "right" and .f == "pinky")) as $f_right_pinky | (($base[$f_right_pinky.at] | tapKeyOf) // {"value":"SEMI"}) as $tk_right_pinky |
  (fingers[] | select(.hand == "right" and .f == "ring")) as $f_right_ring | (($base[$f_right_ring.at] | tapKeyOf) // {"value":"L"}) as $tk_right_ring |
  (fingers[] | select(.hand == "right" and .f == "middy")) as $f_right_middy | (($base[$f_right_middy.at] | tapKeyOf) // {"value":"K"}) as $tk_right_middy |
  (fingers[] | select(.hand == "right" and .f == "index")) as $f_right_index | (($base[$f_right_index.at] | tapKeyOf) // {"value":"J"}) as $tk_right_index |

  # 5. The hold-taps and macros they use
  .holdTaps = ((.holdTaps // []) | put_all([{"name":"&HRM_left_pinky_v1B_TKZ","description":"HRM_left_pinky_bilateral - &HRM_left_pinky_hold -> &kp - Go60 port","bindings":["&HRM_left_pinky_hold_v1B_TKZ","&kp"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_pinky_ring_v1B_TKZ","description":"HRM_left_pinky_ring_bilateral -> &kp -> &HRM_left_pinky_tap - Go60 port","bindings":["&kp","&HRM_left_pinky_tap_v1B_TKZ"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_pinky_middy_v1B_TKZ","description":"HRM_left_pinky_middy_bilateral -> &kp -> &HRM_left_pinky_tap - Go60 port","bindings":["&kp","&HRM_left_pinky_tap_v1B_TKZ"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_pinky_index_v1B_TKZ","description":"HRM_left_pinky_index_bilateral -> &kp -> &HRM_left_pinky_tap - Go60 port","bindings":["&kp","&HRM_left_pinky_tap_v1B_TKZ"],"tappingTermMs":270,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_ring_v1B_TKZ","description":"HRM_left_ring_bilateral - &HRM_left_ring_hold -> &kp - Go60 port","bindings":["&HRM_left_ring_hold_v1B_TKZ","&kp"],"tappingTermMs":240,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":100,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_ring_pinky_v1B_TKZ","description":"HRM_left_ring_pinky_bilateral -> &kp -> &HRM_left_ring_tap - Go60 port","bindings":["&kp","&HRM_left_ring_tap_v1B_TKZ"],"tappingTermMs":240,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":100,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_ring_middy_v1B_TKZ","description":"HRM_left_ring_middy_bilateral -> &kp -> &HRM_left_ring_tap - Go60 port","bindings":["&kp","&HRM_left_ring_tap_v1B_TKZ"],"tappingTermMs":240,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":100,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_ring_index_v1B_TKZ","description":"HRM_left_ring_index_bilateral -> &kp -> &HRM_left_ring_tap - Go60 port","bindings":["&kp","&HRM_left_ring_tap_v1B_TKZ"],"tappingTermMs":240,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":100,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_middy_v1B_TKZ","description":"HRM_left_middy_bilateral - &HRM_left_middy_hold -> &kp - Go60 port","bindings":["&HRM_left_middy_hold_v1B_TKZ","&kp"],"tappingTermMs":210,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_middy_pinky_v1B_TKZ","description":"HRM_left_middy_pinky_bilateral -> &kp -> &HRM_left_middy_tap - Go60 port","bindings":["&kp","&HRM_left_middy_tap_v1B_TKZ"],"tappingTermMs":210,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_middy_ring_v1B_TKZ","description":"HRM_left_middy_ring_bilateral -> &kp -> &HRM_left_middy_tap - Go60 port","bindings":["&kp","&HRM_left_middy_tap_v1B_TKZ"],"tappingTermMs":210,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_middy_index_v1B_TKZ","description":"HRM_left_middy_index_bilateral -> &kp -> &HRM_left_middy_tap - Go60 port","bindings":["&kp","&HRM_left_middy_tap_v1B_TKZ"],"tappingTermMs":210,"flavor":"tap-preferred","quickTapMs":300,"requirePriorIdleMs":150,"holdTriggerOnRelease":true,"holdTriggerKeyPositions":$l_trigs},{"name":"&HRM_left_index_v1B_TKZ","description":"HRM_left_ind